# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Server-only Supabase credential. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_rotated_server_only_service_role_key

# Required dedicated bearer secret when queue worker endpoints are used.
# The robot must never receive the Supabase service-role key as an alternative.
TRADING_WORKER_TOKEN=

# Authoritative server-side trading kill switch for both enqueue and new queue
# claims. Finalization remains available so an accepted broker result can still
# be recorded. Enable only after migrations and paper-trading checks pass.
TRADING_ENABLED=false

# Exactly one Supabase Auth UUID that owns the connected broker account.
# Empty, malformed, comma-separated, or multi-owner values fail closed.
TRADING_ALLOWED_USER_IDS=

# Required to authenticate Vercel Cron requests.
# Generate a random value with at least 32 characters.
CRON_SECRET=

# Optional notification integration.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs. The entire value fails closed if any
# entry is malformed.
TELEGRAM_ALLOWED_CHAT_IDS=
# Exactly one Supabase Auth UUID. Empty, malformed, or multiple UUIDs fail
# closed so one broker/notification owner cannot be confused with another.
TELEGRAM_ALLOWED_USER_IDS=

# Optional AI market summary integration.
GEMINI_API_KEY=
# Optional; defaults to gemini-2.5-flash when the key is configured.
GEMINI_MODEL=gemini-2.5-flash

# Optional browser-side stock stream. This value is exposed to the browser.
# Treat its quota as public/untrusted and leave blank when unused.
NEXT_PUBLIC_FINNHUB_API_KEY=

# Browser UI mirror only; it is not a security boundary.
NEXT_PUBLIC_TRADING_ENABLED=false
